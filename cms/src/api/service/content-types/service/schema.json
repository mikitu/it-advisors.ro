{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service",
    "description": "Servicii IT oferite de companie"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "icon": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "features": {
      "type": "json"
    },
    "fullDescription": {
      "type": "richtext"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "benefits": {
      "type": "json"
    },
    "process": {
      "type": "json"
    },
    "stats": {
      "type": "json"
    },
    "testimonials": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::testimonial.testimonial",
      "mappedBy": "service"
    },
    "showcases": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::showcase.showcase",
      "mappedBy": "service"
    }
  }
}

